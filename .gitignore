# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploaded product images
/public/uploads/products/*
!/public/uploads/products/.gitkeep
/public/uploads/announcements/*
!/public/uploads/announcements/.gitkeep
/public/uploads/company-logos/*
!/public/uploads/company-logos/.gitkeep

# dealer tax exemption documents (private storage)
/storage/tax-documents/*
!/storage/tax-documents/.gitkeep
/storage/client-quotes/*
!/storage/client-quotes/.gitkeep

.vercel
